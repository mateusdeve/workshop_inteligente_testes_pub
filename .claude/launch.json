{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Vercel Dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vercel", "dev", "--listen", "3000", "--yes"],
      "port": 3000
    },
    {
      "name": "Páginas Estáticas (curso-tarot)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 4000
    },
    {
      "name": "Família Viajante",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "http-server", "entregas-familia-viajante", "-p", "4100", "-c-1"],
      "port": 4100
    },
    {
      "name": "Família Viajante 2",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "http-server", "entregas-familia-viajante2", "-p", "4100", "-c-1"],
      "port": 4100
    }
  ]
}
